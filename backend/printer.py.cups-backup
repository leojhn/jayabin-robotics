import os
import platform
import tempfile
import subprocess
import re
import html as html_lib
from html.parser import HTMLParser


# ============================================================
# HTML TO TEXT
# ============================================================

class HTMLToText(HTMLParser):

    BLOCK_TAGS = {
        "p",
        "div",
        "br",
        "h1",
        "h2",
        "h3",
        "h4",
        "tr",
        "li",
        "section"
    }

    def __init__(self):

        super().__init__()

        self.parts = []


    def handle_starttag(self, tag, attrs):

        if tag == "br":

            self.parts.append("\n")

        elif tag in self.BLOCK_TAGS:

            self.parts.append("\n")


    def handle_endtag(self, tag):

        if tag in self.BLOCK_TAGS:

            self.parts.append("\n")

        elif tag in ["td", "th"]:

            self.parts.append("    ")


    def handle_data(self, data):

        self.parts.append(data)


    def get_text(self):

        text = "".join(self.parts)

        text = html_lib.unescape(text)

        text = re.sub(
            r"[ \t]+\n",
            "\n",
            text
        )

        text = re.sub(
            r"\n{3,}",
            "\n\n",
            text
        )

        return text.strip()


# ============================================================
# CROSS PLATFORM PRINTER
# ============================================================

class ThermalPrinter:


    def __init__(self):

        self.printer_name = os.environ.get(
            "HMS_PRINTER_NAME",
            ""
        ).strip()

        self.system = platform.system()


    # ========================================================
    # WINDOWS PRINTER
    # ========================================================

    def get_windows_printer(self):

        try:

            import win32print

            if self.printer_name:

                return self.printer_name

            return win32print.GetDefaultPrinter()

        except ImportError:

            raise RuntimeError(
                "pywin32 is not installed. "
                "Run: pip install pywin32"
            )


    # ========================================================
    # LINUX / RASPBERRY PI PRINTER
    # ========================================================

    def get_linux_printer(self):

        if self.printer_name:

            return self.printer_name

        try:

            result = subprocess.run(
                ["lpstat", "-d"],
                capture_output=True,
                text=True,
                timeout=10
            )

            if result.returncode != 0:

                raise RuntimeError(
                    "No default printer configured."
                )

            match = re.search(
                r"(default destination|system default destination):\s*(.+)",
                result.stdout,
                re.IGNORECASE
            )

            if not match:

                raise RuntimeError(
                    "No default CUPS printer found."
                )

            return match.group(2).strip()

        except FileNotFoundError:

            raise RuntimeError(
                "CUPS is not installed. "
                "Install using: sudo apt install cups"
            )


    # ========================================================
    # RECEIPT DICTIONARY TO PRINTABLE TEXT
    # ========================================================

    def receipt_to_text(self, receipt):

        patient_name = str(
            receipt.get("patientName", "N/A")
        )

        patient_id = str(
            receipt.get("patientId", "N/A")
        )

        appointment_id = str(
            receipt.get("appointmentId", "N/A")
        )

        token = str(
            receipt.get("token", "N/A")
        )

        receipt_no = str(
            receipt.get("receiptNo", "N/A")
        )

        consultant = str(
            receipt.get("consultant", "N/A")
        )

        payment_method = str(
            receipt.get("paymentMethod", "N/A")
        )

        status = str(
            receipt.get("status", "N/A")
        )

        date = str(
            receipt.get("date", "N/A")
        )

        time = str(
            receipt.get("time", "N/A")
        )

        amount = str(
            receipt.get("amount", "0")
        )

        return f"""
================================
         HOSPITAL RECEIPT
================================

Receipt No : {receipt_no}

--------------------------------
PATIENT INFORMATION
--------------------------------

Patient Name : {patient_name}
Patient ID   : {patient_id}

Appointment ID : {appointment_id}
Token          : {token}

--------------------------------
CONSULTATION BILL
--------------------------------

Consultant      : {consultant}
Payment Method  : {payment_method}
Status          : {status}

Date : {date}
Time : {time}

--------------------------------

TOTAL AMOUNT : Rs. {amount}

================================
          THANK YOU
================================



"""


    # ========================================================
    # HTML TO TEXT
    # ========================================================

    def html_to_text(self, content):

        parser = HTMLToText()

        parser.feed(
            str(content)
        )

        return (
            parser.get_text()
            +
            "\n\n\n"
        )


    # ========================================================
    # WINDOWS PRINT
    # ========================================================

    def print_windows(self, text):

        try:

            import win32print

        except ImportError:

            raise RuntimeError(
                "Windows printing requires pywin32.\n"
                "Install using:\n"
                "pip install pywin32"
            )

        printer_name = self.get_windows_printer()

        handle = None

        try:

            handle = win32print.OpenPrinter(
                printer_name
            )

            job = win32print.StartDocPrinter(
                handle,
                1,
                (
                    "HMS Receipt",
                    None,
                    "RAW"
                )
            )

            win32print.StartPagePrinter(
                handle
            )

            printable_text = text.replace(
                "₹",
                "Rs."
            )

            data = printable_text.encode(
                "cp437",
                errors="replace"
            )

            win32print.WritePrinter(
                handle,
                data
            )

            win32print.EndPagePrinter(
                handle
            )

            win32print.EndDocPrinter(
                handle
            )

            return {
                "success": True,
                "printer": printer_name,
                "job": job
            }

        except Exception as e:

            raise RuntimeError(
                f"Windows printer error: {str(e)}"
            )

        finally:

            if handle:

                win32print.ClosePrinter(
                    handle
                )


    # ========================================================
    # LINUX / RASPBERRY PI PRINT
    # ========================================================

    def print_linux(self, text):

        printer_name = self.get_linux_printer()

        temp_path = None

        try:

            with tempfile.NamedTemporaryFile(
                delete=False,
                suffix=".txt",
                mode="w",
                encoding="utf-8"
            ) as temp:

                temp.write(text)

                temp_path = temp.name

            result = subprocess.run(
                [
                    "lp",
                    "-d",
                    printer_name,
                    temp_path
                ],
                capture_output=True,
                text=True,
                timeout=30
            )

            if result.returncode != 0:

                raise RuntimeError(
                    result.stderr.strip()
                    or
                    "CUPS could not print the receipt."
                )

            return {
                "success": True,
                "printer": printer_name,
                "job": result.stdout.strip()
            }

        finally:

            if temp_path and os.path.exists(temp_path):

                try:

                    os.remove(temp_path)

                except OSError:

                    pass


    # ========================================================
    # MAIN PRINT FUNCTION
    # ========================================================

    def print_html(self, content):

        # Receipt object from frontend
        if isinstance(content, dict):

            text = self.receipt_to_text(
                content
            )

        # Actual HTML/text
        else:

            text = self.html_to_text(
                content
            )

        # WINDOWS
        if self.system == "Windows":

            return self.print_windows(
                text
            )

        # LINUX / RASPBERRY PI
        elif self.system == "Linux":

            return self.print_linux(
                text
            )

        else:

            raise RuntimeError(
                f"Unsupported operating system: "
                f"{self.system}"
            )


# ============================================================
# PRINTER OBJECT
# ============================================================

printer = ThermalPrinter()